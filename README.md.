<title>Viril — Саморазвитие</title>
<style>
:root{color-scheme:dark;--bg:#090b12;--panel:#111520;--panel2:#151b29;--text:#f1f5ff;--muted:#8c96ad;--line:#252d40;--cyan:#65f6e0;--violet:#a58bff;--pink:#ff76b7;--green:#7af0a3;--danger:#ff7285;--radius:22px}
*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}button,input,select{font:inherit}button{cursor:pointer;color:inherit}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}.app{min-height:100vh;position:relative;overflow:hidden;background:radial-gradient(ellipse at 8% 0%,rgba(101,246,224,.08),transparent 33%),radial-gradient(ellipse at 100% 25%,rgba(165,139,255,.09),transparent 35%),var(--bg)}#particles{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:.48}.shell{position:relative;z-index:1;width:min(100%,900px);margin:auto;padding:26px 18px 110px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:26px}.brand{display:flex;align-items:center;gap:11px}.brand-mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(101,246,224,.2),rgba(165,139,255,.2));border:1px solid rgba(101,246,224,.45);box-shadow:0 0 24px rgba(101,246,224,.12);font-size:22px;font-weight:900;color:var(--cyan)}.brand h1{font-size:19px;letter-spacing:.12em;margin:0;font-weight:850}.brand p{margin:3px 0 0;font-size:11px;color:var(--muted);letter-spacing:.17em;text-transform:uppercase}.date-chip{font-size:12px;color:var(--muted);padding:9px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(17,21,32,.8)}.eyebrow{color:var(--cyan);font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin:0 0 9px}.hero{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-bottom:17px}.panel{background:linear-gradient(145deg,rgba(20,26,40,.96),rgba(13,17,27,.96));border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 18px 60px rgba(0,0,0,.16)}.level-card{padding:23px;position:relative;overflow:hidden}.level-card:after{content:"";position:absolute;width:170px;height:170px;border-radius:50%;right:-65px;top:-80px;border:1px solid rgba(101,246,224,.18);box-shadow:0 0 0 20px rgba(101,246,224,.025),0 0 0 40px rgba(165,139,255,.025);pointer-events:none}.level-line{display:flex;align-items:center;gap:10px}.level-badge{width:46px;height:46px;display:grid;place-items:center;border-radius:15px;color:var(--cyan);font-size:18px;font-weight:900;background:rgba(101,246,224,.09);border:1px solid rgba(101,246,224,.25)}.level-name{font-weight:800;font-size:17px}.rank-name{color:var(--muted);font-size:12px;margin-top:4px}.xp-total{font-size:clamp(34px,8vw,47px);font-weight:900;letter-spacing:-.05em;margin:20px 0 2px}.xp-total span{font-size:15px;color:var(--cyan);letter-spacing:0}.xp-sub{color:var(--muted);font-size:12px}.progress-track{height:7px;background:#252d3d;border-radius:999px;overflow:hidden;margin:17px 0 9px}.progress-fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--cyan),var(--violet));box-shadow:0 0 14px rgba(101,246,224,.45);transition:width .6s cubic-bezier(.2,.8,.2,1)}.progress-meta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:11px}.rank-card{padding:20px;display:flex;flex-direction:column;justify-content:space-between;min-height:210px}.rank-symbol{font-size:34px;filter:drop-shadow(0 0 14px rgba(165,139,255,.3))}.rank-card h3{font-size:19px;margin:12px 0 5px}.rank-card p{font-size:12px;color:var(--muted);line-height:1.5;margin:0}.rank-pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:15px}.rank-pills span{font-size:10px;border:1px solid var(--line);border-radius:999px;padding:6px 8px;color:#c7cfe0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:28px 2px 13px}.section-head h2{font-size:20px;margin:0;letter-spacing:-.03em}.section-head p{font-size:12px;color:var(--muted);margin:5px 0 0}.tiny-count{color:var(--cyan);font-size:12px;font-weight:800;white-space:nowrap}.add-panel{padding:18px}.field-label{display:block;color:#b8c1d4;font-size:12px;margin-bottom:8px;font-weight:650}.goal-input{width:100%;background:#0b0f18;color:var(--text);border:1px solid #2b3449;border-radius:14px;padding:14px 14px;outline:none;transition:border .2s,box-shadow .2s}.goal-input:focus{border-color:rgba(101,246,224,.6);box-shadow:0 0 0 3px rgba(101,246,224,.07)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:14px}.xp-options{display:flex;gap:7px;flex-wrap:wrap}.xp-choice{border:1px solid #30394e;background:#0b0f18;border-radius:11px;padding:9px 12px;color:#c0c9db;font-size:12px;transition:transform .16s,border-color .16s,background .16s}.xp-choice:hover{transform:translateY(-2px)}.xp-choice.active{border-color:var(--cyan);background:rgba(101,246,224,.1);color:var(--cyan);box-shadow:inset 0 0 0 1px rgba(101,246,224,.1)}.penalty-select{width:100%;background:#0b0f18;border:1px solid #30394e;border-radius:11px;color:var(--text);padding:10px}.primary-btn{border:0;border-radius:13px;background:linear-gradient(105deg,var(--cyan),#9af7d6);color:#071211;font-weight:850;padding:13px 17px;box-shadow:0 7px 24px rgba(101,246,224,.13);transition:transform .18s,filter .18s;display:inline-flex;align-items:center;justify-content:center;gap:8px}.primary-btn:hover{filter:brightness(1.07);transform:translateY(-2px)}.primary-btn:active,.secondary-btn:active,.goal-check:active{transform:scale(.97)}.add-btn{width:100%;margin-top:15px}.secondary-btn{border:1px solid #30394e;background:#151b29;color:#d7deec;border-radius:12px;padding:10px 13px;font-size:12px;transition:transform .18s,border-color .18s}.secondary-btn:hover{border-color:#65728b;transform:translateY(-1px)}.goal-list{display:grid;gap:10px}.goal-item{padding:15px;display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:center;transition:transform .22s,border-color .22s,opacity .22s}.goal-item:hover{transform:translateY(-2px);border-color:#3b4960}.goal-item.completed{border-color:rgba(122,240,163,.28);background:linear-gradient(135deg,rgba(23,49,42,.76),rgba(13,17,27,.96))}.goal-check{width:39px;height:39px;border-radius:13px;border:1px solid #38445a;background:#101522;display:grid;place-items:center;color:transparent;font-size:18px;transition:all .2s}.completed .goal-check{background:rgba(122,240,163,.13);border-color:var(--green);color:var(--green);box-shadow:0 0 18px rgba(122,240,163,.08)}.goal-title{font-size:14px;font-weight:700;line-height:1.4;overflow-wrap:anywhere}.completed .goal-title{text-decoration:line-through;color:#9caeaa}.goal-meta{font-size:11px;color:var(--muted);margin-top:5px;display:flex;gap:9px;flex-wrap:wrap}.goal-xp{font-size:12px;font-weight:850;color:var(--cyan);white-space:nowrap}.completed .goal-xp{color:var(--green)}.goal-actions{display:flex;align-items:center;gap:8px}.delete-btn{border:0;background:transparent;color:#6e7890;padding:7px;font-size:17px;border-radius:8px}.delete-btn:hover{color:var(--danger);background:rgba(255,114,133,.08)}.empty-state{text-align:center;padding:29px 16px;color:var(--muted)}.empty-icon{font-size:28px;margin-bottom:9px}.empty-state strong{display:block;color:#dbe3f3;font-size:14px;margin-bottom:5px}.empty-state span{font-size:12px}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:25px}.mini-panel{padding:18px}.mini-panel h3{margin:0;font-size:14px}.mini-panel p{font-size:12px;line-height:1.55;color:var(--muted);margin:8px 0 0}.stat-number{font-size:25px;font-weight:850;margin-top:13px;letter-spacing:-.04em}.stat-number em{font-size:12px;color:var(--cyan);font-style:normal}.profile-panel{padding:20px}.profile-top{display:flex;align-items:center;gap:14px}.avatar-wrap{width:68px;height:68px;border-radius:22px;overflow:hidden;display:grid;place-items:center;flex-shrink:0;background:linear-gradient(135deg,rgba(101,246,224,.17),rgba(165,139,255,.24));border:1px solid rgba(101,246,224,.35);font-size:25px;font-weight:900;color:var(--cyan)}.avatar-wrap img{width:100%;height:100%;object-fit:cover}.profile-name{font-size:18px;font-weight:800}.profile-sub{font-size:12px;color:var(--muted);margin-top:5px}.profile-fields{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:18px}.file-label{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid #30394e;background:#151b29;color:#d7deec;border-radius:12px;padding:10px 12px;font-size:12px;cursor:pointer}.file-label input{display:none}.profile-save{margin-top:11px;width:100%}.toast{position:fixed;z-index:10;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#e6fff9;color:#061512;padding:12px 17px;border-radius:13px;font-size:13px;font-weight:800;box-shadow:0 12px 40px #0008;transition:all .25s;max-width:calc(100% - 28px);text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}.confetti{position:fixed;z-index:8;pointer-events:none;font-size:18px;animation:pop .8s ease-out forwards}@keyframes pop{0%{transform:translate(0,0) scale(.5);opacity:1}100%{transform:translate(var(--dx),-95px) rotate(160deg) scale(1.2);opacity:0}}.footer{text-align:center;color:#5e687f;font-size:10px;letter-spacing:.13em;margin-top:30px}.footer span{color:#6eebd9}.reset-link{display:block;margin:10px auto 0;background:transparent;border:0;color:#68748b;font-size:11px;text-decoration:underline;text-underline-offset:3px}.modal-backdrop{position:fixed;inset:0;background:rgba(2,4,9,.7);backdrop-filter:blur(8px);z-index:20;display:none;align-items:center;justify-content:center;padding:20px}.modal-backdrop.open{display:flex}.modal{width:min(100%,390px);padding:23px;background:#121724;border:1px solid #344057;border-radius:22px;box-shadow:0 20px 80px #0009}.modal h3{margin:0 0 8px}.modal p{color:var(--muted);font-size:13px;line-height:1.6}.modal-actions{display:flex;gap:9px;margin-top:18px}.modal-actions>*{flex:1}.hidden{display:none!important}
@media(max-width:620px){.shell{padding:18px 13px 95px}.hero{grid-template-columns:1fr}.level-card{padding:20px}.rank-card{min-height:165px}.rank-card .rank-symbol{font-size:27px}.rank-card h3{margin:7px 0 4px}.rank-pills{margin-top:10px}.form-grid{grid-template-columns:1fr}.goal-item{grid-template-columns:38px 1fr auto;gap:9px;padding:13px}.goal-check{width:36px;height:36px}.goal-title{font-size:13px}.bottom-grid{gap:10px}.mini-panel{padding:14px}.section-head h2{font-size:18px}.date-chip{font-size:10px;padding:8px 9px}.profile-fields{grid-template-columns:1fr}.file-label{min-height:42px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="app" id="appRoot"><canvas id="particles" aria-hidden="true"></canvas><main class="shell">
<header class="topbar"><div class="brand"><div class="brand-mark">V</div><div><h1>VIRIL</h1><p>Саморазвитие · каждый день</p></div></div><div class="date-chip" id="dateChip"></div></header>
<section class="hero"><article class="panel level-card"><p class="eyebrow">Твой прогресс</p><div class="level-line"><div class="level-badge" id="levelBadge">01</div><div><div class="level-name" id="levelName">Уровень 1</div><div class="rank-name" id="rankName">Лига: Новичок</div></div></div><div class="xp-total"><span id="xpTotal">0</span> <span>XP</span></div><div class="xp-sub">Опыт, который ты заработал</div><div class="progress-track"><div class="progress-fill" id="levelProgress"></div></div><div class="progress-meta"><span id="progressCaption">До следующего уровня</span><span id="progressNumbers">0 / 100 XP</span></div></article>
<article class="panel rank-card"><div><div class="rank-symbol" id="rankSymbol">✧</div><p class="eyebrow">Твоя лига</p><h3 id="rankCardName">Новичок</h3><p id="rankDescription">Большие перемены начинаются с одного выполненного обещания.</p></div><div class="rank-pills"><span id="streakPill">⚡ 0 выполнено сегодня</span><span id="dailyPill">◷ Новый день — новый шанс</span></div></article></section>
<section><div class="section-head"><div><h2>Цели на сегодня</h2><p id="todaySubtitle">Один шаг за раз. Держи слово перед собой.</p></div><span class="tiny-count" id="goalCount">0 целей</span></div>
<div class="panel add-panel"><label class="field-label" for="goalText">Какую цель ты выполнишь сегодня?</label><input class="goal-input" id="goalText" maxlength="120" placeholder="Например: 30 минут тренировки" autocomplete="off"><div class="form-grid"><div><span class="field-label">Награда за выполнение</span><div class="xp-options" id="xpOptions"><button class="xp-choice" data-xp="5">+5 XP</button><button class="xp-choice" data-xp="10">+10 XP</button><button class="xp-choice active" data-xp="15">+15 XP</button><button class="xp-choice" data-xp="20">+20 XP</button><button class="xp-choice" data-xp="25">+25 XP</button></div></div><div><label class="field-label" for="penaltySelect">Штраф за невыполнение</label><select class="penalty-select" id="penaltySelect"><option value="5">−5 XP</option><option value="10">−10 XP</option></select></div></div><button class="primary-btn add-btn" id="addGoal"><span>＋</span> Добавить цель</button></div>
<div class="goal-list" id="goalList" style="margin-top:12px"></div></section>
<div class="bottom-grid"><article class="panel mini-panel"><h3>Выполнено сегодня</h3><div class="stat-number"><span id="doneCount">0</span> <em>/ <span id="totalCount">0</span> целей</em></div><p>Не стремись к идеалу. Стремись быть последовательным.</p></article><article class="panel mini-panel"><h3>Штрафы за день</h3><div class="stat-number" id="penaltyTotal">0 <em>XP</em></div><p>Штраф применяется один раз за каждую незавершённую цель после смены дня.</p></article></div>
<section><div class="section-head"><div><h2>Профиль</h2><p>Настрой свой игровой образ</p></div></div><div class="panel profile-panel"><div class="profile-top"><div class="avatar-wrap" id="avatarWrap"><span id="avatarInitial">V</span></div><div><div class="profile-name" id="profileDisplayName">Viril</div><div class="profile-sub" id="profileSub">Путь дисциплины начинается сегодня</div></div></div><div class="profile-fields"><div><label class="field-label" for="nicknameInput">Твой никнейм</label><input class="goal-input" id="nicknameInput" maxlength="24" value="Viril" placeholder="Введи никнейм"></div><label class="file-label">↥ Загрузить фото<input type="file" id="avatarInput" accept="image/*"></label></div><button class="secondary-btn profile-save" id="saveProfile">Сохранить профиль</button><button class="reset-link" id="resetButton">Сбросить прогресс на этом устройстве</button></div></section>
<div class="footer">BUILT BY DISCIPLINE <span>✦</span> VIRIL SELF-DEVELOPMENT</div>
</main></div><div class="toast" id="toast" role="status" aria-live="polite"></div>
<div class="modal-backdrop" id="modalBackdrop"><div class="modal"><h3 id="modalTitle">Сбросить прогресс?</h3><p id="modalText">Все цели и накопленный XP будут удалены с этого устройства.</p><div class="modal-actions"><button class="secondary-btn" id="cancelModal">Отмена</button><button class="primary-btn" id="confirmModal">Сбросить</button></div></div></div>
<script>
(()=>{'use strict';
const KEY='viril_self_development_v1';const DAY=86400000;const thresholds=n=>n<=1?0:100+(n-2)*50;let selectedXP=15,toastTimer;let state={xp:0,level:1,nickname:'Viril',avatar:'',goals:[],lastDate:localDate(),history:{},penaltyTotal:0};
const $=id=>document.getElementById(id);const safeNumber=n=>Number.isFinite(Number(n))?Number(n):0;
function localDate(d=new Date()){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){showToast('Не удалось сохранить. Возможно, фото слишком большое.');}}
function load(){try{const raw=localStorage.getItem(KEY);if(raw){const v=JSON.parse(raw);if(v&&typeof v==='object'){state={...state,...v};state.xp=Math.max(0,safeNumber(state.xp));state.goals=Array.isArray(state.goals)?state.goals:[];state.history=state.history||{};}}}catch(e){}checkDay();normalizeLevel();}
function normalizeLevel(){state.xp=Math.max(0,Math.floor(safeNumber(state.xp)));let level=1;while(level<100&&state.xp>=thresholds(level+1))level++;state.level=level;}
function checkDay(){const today=localDate();if(!state.lastDate){state.lastDate=today;return}if(state.lastDate!==today){const oldDate=state.lastDate;let lost=0;state.goals.forEach(g=>{if(!g.done&&!g.penaltyApplied){const penalty=Math.max(5,Math.min(10,safeNumber(g.penalty)||5));lost+=penalty;g.penaltyApplied=true;g.expired=true;}});state.xp=Math.max(0,state.xp-lost);state.penaltyTotal=safeNumber(state.penaltyTotal)+lost;state.history[oldDate]={...(state.history[oldDate]||{}),expired:true,penalty:lost};state.goals=[];state.lastDate=today;normalizeLevel();if(lost)state._pendingDayMessage=`Новый день! За незавершённые цели снято ${lost} XP.`;else state._pendingDayMessage='Новый день — новые возможности. Запиши цели!';save();}}
function rankFor(level){if(level>=25)return {name:'Легенда',symbol:'✹',desc:'Твоя дисциплина вдохновляет. Продолжай строить свою историю.'};if(level>=15)return {name:'Мастер',symbol:'✦',desc:'Ты умеешь превращать намерения в действия.'};if(level>=10)return {name:'Элита',symbol:'⬡',desc:'Стабильность становится твоей сильной стороной.'};if(level>=6)return {name:'Ветеран',symbol:'◈',desc:'Ты уже доказал, что умеешь держать курс.'};if(level>=3)return {name:'Воин',symbol:'✧',desc:'Ты растёшь с каждым выполненным обещанием.'};if(level>=2)return {name:'Ученик',symbol:'◇',desc:'Фундамент заложен. Продолжай набирать темп.'};return {name:'Новичок',symbol:'✧',desc:'Большие перемены начинаются с одного выполненного обещания.'}}
function levelStart(level){return thresholds(level)}function levelEnd(level){return thresholds(level+1)}
function render(){normalizeLevel();const rank=rankFor(state.level);$('xpTotal').textContent=state.xp.toLocaleString('ru-RU');$('levelBadge').textContent=String(state.level).padStart(2,'0');$('levelName').textContent=`Уровень ${state.level}`;$('rankName').textContent=`Лига: ${rank.name}`;$('rankCardName').textContent=rank.name;$('rankSymbol').textContent=rank.symbol;$('rankDescription').textContent=rank.desc;const start=levelStart(state.level),end=levelEnd(state.level),progress=state.xp-start,needed=end-start;$('levelProgress').style.width=`${Math.max(0,Math.min(100,progress/needed*100))}%`;$('progressCaption').textContent=`До уровня ${state.level+1}`;$('progressNumbers').textContent=`${progress} / ${needed} XP`;
const done=state.goals.filter(g=>g.done).length,total=state.goals.length;$('doneCount').textContent=done;$('totalCount').textContent=total;$('goalCount').textContent=`${total} ${plural(total,['цель','цели','целей'])}`;$('streakPill').textContent=`⚡ ${done} выполнено сегодня`;$('dailyPill').textContent=total&&done===total?'✓ Все цели закрыты':`◷ ${Math.max(0,total-done)} осталось`;$('penaltyTotal').innerHTML=`${safeNumber(state.penaltyTotal)} <em>XP</em>`;$('dateChip').textContent=new Date().toLocaleDateString('ru-RU',{weekday:'short',day:'numeric',month:'short'}).replace('.','');$('profileDisplayName').textContent=state.nickname||'Viril';$('nicknameInput').value=state.nickname||'Viril';$('profileSub').textContent=`Уровень ${state.level} · Лига ${rank.name}`;if(state.avatar){$('avatarWrap').innerHTML=`<img src="${state.avatar}" alt="Фото профиля">`}else{$('avatarWrap').innerHTML=`<span id="avatarInitial">${escapeHTML((state.nickname||'V').trim().charAt(0).toUpperCase()||'V')}</span>`}
const list=$('goalList');if(!total){list.innerHTML='<div class="panel empty-state"><div class="empty-icon">✧</div><strong>Твой день начинается здесь</strong><span>Добавь первую цель и назначь ей награду XP.</span></div>'}else{list.innerHTML=state.goals.map(g=>`<article class="panel goal-item ${g.done?'completed':''}" data-id="${escapeHTML(g.id)}"><button class="goal-check" data-action="toggle" aria-label="${g.done?'Отменить выполнение':'Отметить выполненной'}">✓</button><div><div class="goal-title">${escapeHTML(g.text)}</div><div class="goal-meta"><span>${g.done?'✓ Выполнено':'○ В процессе'}</span><span>Штраф −${g.penalty} XP, если не выполнено</span></div></div><div class="goal-actions"><span class="goal-xp">${g.done?'+':''}${g.xp} XP</span><button class="delete-btn" data-action="delete" aria-label="Удалить цель" title="Удалить цель">×</button></div></article>`).join('')}
}
function plural(n,forms){n=Math.abs(n)%100;const n1=n%10;if(n>10&&n<20)return forms[2];if(n1>1&&n1<5)return forms[1];if(n1===1)return forms[0];return forms[2]}
function showToast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2700)}
function burst(el){const r=el.getBoundingClientRect();['✦','＋','✧','•','✦'].forEach((s,i)=>{const n=document.createElement('span');n.className='confetti';n.textContent=s;n.style.left=(r.left+r.width/2+(Math.random()*24-12))+'px';n.style.top=(r.top+r.height/2)+'px';n.style.color=['#65f6e0','#a58bff','#7af0a3','#ff76b7'][i%4];n.style.setProperty('--dx',(Math.random()*110-55)+'px');document.body.appendChild(n);setTimeout(()=>n.remove(),900)})}
function addGoal(){const text=$('goalText').value.trim();if(!text){showToast('Сначала напиши свою цель');$('goalText').focus();return}if(text.length>120){showToast('Сделай формулировку короче');return}state.goals.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),text,xp:Math.max(5,Math.min(25,selectedXP)),penalty:Number($('penaltySelect').value)===10?10:5,done:false,penaltyApplied:false,created:Date.now()});$('goalText').value='';save();render();showToast('Цель добавлена. Теперь действуй!')}
function toggleGoal(id,el){const g=state.goals.find(x=>x.id===id);if(!g)return;if(g.done){g.done=false;state.xp=Math.max(0,state.xp-g.xp);showToast(`Выполнение отменено: −${g.xp} XP`)}else{g.done=true;state.xp+=g.xp;burst(el);showToast(`Отлично! +${g.xp} XP. Продолжай!`)}normalizeLevel();save();render()}
$('xpOptions').addEventListener('click',e=>{const b=e.target.closest('[data-xp]');if(!b)return;selectedXP=Number(b.dataset.xp);$('xpOptions').querySelectorAll('.xp-choice').forEach(x=>x.classList.toggle('active',x===b))});$('addGoal').addEventListener('click',addGoal);$('goalText').addEventListener('keydown',e=>{if(e.key==='Enter')addGoal()});$('goalList').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b)return;const item=b.closest('[data-id]');if(!item)return;const id=item.dataset.id;if(b.dataset.action==='toggle')toggleGoal(id,b);if(b.dataset.action==='delete'){const g=state.goals.find(x=>x.id===id);if(g?.done)state.xp=Math.max(0,state.xp-g.xp);state.goals=state.goals.filter(x=>x.id!==id);normalizeLevel();save();render();showToast('Цель удалена')}});
$('saveProfile').addEventListener('click',()=>{const n=$('nicknameInput').value.trim();if(!n){showToast('Никнейм не может быть пустым');return}state.nickname=n.slice(0,24);save();render();showToast('Профиль сохранён')});$('avatarInput').addEventListener('change',e=>{const file=e.target.files&&e.target.files[0];if(!file)return;if(!file.type.startsWith('image/')){showToast('Выбери файл изображения');return}if(file.size>4*1024*1024){showToast('Фото должно быть меньше 4 МБ');e.target.value='';return}const reader=new FileReader();reader.onload=()=>{const img=new Image();img.onload=()=>{const canvas=document.createElement('canvas');const size=320;canvas.width=size;canvas.height=size;const ctx=canvas.getContext('2d');const scale=Math.max(size/img.width,size/img.height);const w=img.width*scale,h=img.height*scale;ctx.drawImage(img,(size-w)/2,(size-h)/2,w,h);state.avatar=canvas.toDataURL('image/jpeg',.82);save();render();showToast('Фото профиля обновлено')};img.src=reader.result};reader.readAsDataURL(file)});
const backdrop=$('modalBackdrop');$('resetButton').addEventListener('click',()=>backdrop.classList.add('open'));$('cancelModal').addEventListener('click',()=>backdrop.classList.remove('open'));$('confirmModal').addEventListener('click',()=>{state={xp:0,level:1,nickname:'Viril',avatar:'',goals:[],lastDate:localDate(),history:{},penaltyTotal:0};save();backdrop.classList.remove('open');render();showToast('Прогресс сброшен')});backdrop.addEventListener('click',e=>{if(e.target===backdrop)backdrop.classList.remove('open')});
// Light ambient particles, kept deliberately subtle.
const canvas=$('particles'),ctx=canvas.getContext('2d');let particles=[];function resize(){const dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=innerWidth*dpr;canvas.height=innerHeight*dpr;canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';ctx.setTransform(dpr,0,0,dpr,0,0);particles=Array.from({length:Math.min(42,Math.max(18,Math.floor(innerWidth/22)))} ,()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.5+.35,vx:(Math.random()-.5)*.18,vy:(Math.random()-.5)*.16,a:Math.random()*.42+.12,c:Math.random()>.5?'101,246,224':'165,139,255'}))}function animate(){ctx.clearRect(0,0,innerWidth,innerHeight);for(const p of particles){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=innerWidth;if(p.x>innerWidth)p.x=0;if(p.y<0)p.y=innerHeight;if(p.y>innerHeight)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(${p.c},${p.a})`;ctx.fill()}requestAnimationFrame(animate)}window.addEventListener('resize',resize);load();render();resize();animate();setInterval(()=>{const before=state.lastDate;checkDay();if(state.lastDate!==before){render();if(state._pendingDayMessage){showToast(state._pendingDayMessage);delete state._pendingDayMessage;save()}}},60000);document.addEventListener('visibilitychange',()=>{if(!document.hidden){const before=state.lastDate;checkDay();if(state.lastDate!==before){render();if(state._pendingDayMessage){showToast(state._pendingDayMessage);delete state._pendingDayMessage;save()}}}});if(state._pendingDayMessage){showToast(state._pendingDayMessage);delete state._pendingDayMessage;save()}
})();
</script>
